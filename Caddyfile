{
	email {$ACME_EMAIL}
	# LAN/local testing: set CADDY_TLS_MODE=local_certs in .env to use Caddy's own CA instead of
	# public certificates (Let's Encrypt/ZeroSSL can't validate private IPs). Leave empty in production.
	{$CADDY_TLS_MODE}
}

# Main site: dashboards + API
{$DOMAIN} {
	encode zstd gzip

	@backend path /api/* /ws /ws/*
	handle @backend {
		reverse_proxy backend:8081
	}
	handle /admin* {
		reverse_proxy admin:3001
	}
	handle /company* {
		reverse_proxy company:3002
	}
	handle {
		reverse_proxy cuetrack:3003
	}
}

# www -> bare domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Public customer portal (table QR codes point here)
pay.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy pay:3004
}
