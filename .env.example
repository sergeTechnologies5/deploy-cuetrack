# Copy to .env on the VPS and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32

# DNS: A records for DOMAIN and pay.DOMAIN -> VPS IP
DOMAIN=cuetrack.example.com
# Company website (landing page). DNS: A records for SITE_DOMAIN and www.SITE_DOMAIN -> VPS IP
SITE_DOMAIN=example.com
ACME_EMAIL=you@example.com

DB_USER=cuetrack
DB_PASSWORD=change-me

# 64 hex chars (HS256 key)
JWT_SECRET=change-me
# Encrypts payment provider credentials at rest - keep a safe copy, losing it = re-enter credentials
CUETRACK_CRED_KEY=change-me

# MQTT accounts - the broker builds its password file from these on every start
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
# what the ESP boards use (device/cuetrack.py MQTT_USER / MQTT_PASS)
MQTT_DEVICE_USER=device
MQTT_DEVICE_PASSWORD=change-me

# Platform owner seeded on first start (must change password at first login).
# Leave SEED_ADMIN_PASSWORD empty to have a random one printed once in `logs backend`.
SEED_ADMIN_EMAIL=phineas@cuetrack.io
SEED_ADMIN_PASSWORD=

# Production: leave empty. LAN testing: local_certs (Caddy self-signed CA)
CADDY_TLS_MODE=
